{
  "compilerOptions": {
    "target": "es6",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "removeComments": true,
    "sourceMap": true,
    "baseUrl": "./",
    "paths": {
      "@framework/*": ["Framework/src/*"]
    },
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "allowJs": true // ★この行も追加すると良いでしょう
  },
  "include": [
    "src/**/*.ts",
    "./Core/*.ts",
    "./Core/*.js" // ★この行を追加
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}